// schema_v2.prisma
// Optimized for PostgreSQL Production Deployment
// Includes consistency constraints, precision fixes, index optimizations, & auditability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  profile         Profile?
  sessions        Session[]
  devices         Device[]
  wallet          Wallet?
  kycVerification KYCVerification?

  requestedTasks Task[] @relation("RequesterTasks")
  acceptedTasks  Task[] @relation("TaskerTasks")

  applications TaskApplication[]

  givenReviews    Review[] @relation("GivenReviews")
  receivedReviews Review[] @relation("ReceivedReviews")

  notifications Notification[]
  sentMessages  Message[]      @relation("SentMessages")

  messageThreadsAsRequester MessageThread[] @relation("RequesterThreads")
  messageThreadsAsTasker    MessageThread[] @relation("TaskerThreads")

  raisedDisputes Dispute[]      @relation("DisputesRaised")
  adminLogs      AdminLog[]     @relation("AdminLogs")
  cancellations  Cancellation[]

  societyMemberships     SocietyMembership[]
  federationMemberships  FederationMembership[]
  VerifiedCertifications Certification[]        @relation("VerifiedCertifications")
  welfareProfile         WorkerWelfareProfile?
  welfareClaims          WelfareClaim[]

  @@index([email])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  fullName    String?
  bio         String?
  avatarUrl   String?
  locationLat Float?
  locationLng Float?
  trustScore  Float    @default(0.0)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      Skill[]
  userMetrics UserMetrics?

  certifications Certification[]

  // Spatial search optimization (PostGIS placeholder for latency optimization)
  @@index([locationLat, locationLng])
  @@index([trustScore(sort: Desc)])
}

model Device {
  id         String   @id @default(uuid())
  userId     String
  pushToken  String   @unique
  deviceType String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model Skill {
  id   String @id @default(uuid())
  name String @unique

  profiles      Profile[]
  tasks         TaskSkill[]
  service       Service?        @relation(fields: [serviceId], references: [id])
  serviceId     String?
  Certification Certification[]

  @@index([name])
}

model TaskSkill {
  taskId  String
  skillId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([taskId, skillId])
  @@index([skillId])
}

model Task {
  id           String   @id @default(uuid())
  requesterId  String
  taskerId     String?
  title        String
  description  String
  // Precision adjusted to prevent monetary rounding errors during percentile fee maths
  price        Float
  status       String   @default("OPEN")
  scheduledFor DateTime
  locationLat  Float
  locationLng  Float
  address      String?
  landmark     String?
  city         String?
  state        String?
startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  requester     User              @relation("RequesterTasks", fields: [requesterId], references: [id], onDelete: Restrict)
  tasker        User?             @relation("TaskerTasks", fields: [taskerId], references: [id], onDelete: SetNull)
  skills        TaskSkill[]
  applications  TaskApplication[]
  escrowEntry   EscrowEntry?
  reviews       Review[]
  messageThread MessageThread?
  media         MediaAttachment[]
  dispute       Dispute?
  cancellations Cancellation[]
  service       Service?          @relation(fields: [serviceId], references: [id])
  serviceId     String?

  // Real-time querying indices 
  @@index([status, scheduledFor])
  @@index([locationLat, locationLng], name: "task_location_idx") // B-Tree mapping for geo-bounding radius
  @@index([requesterId])
  @@index([taskerId])
}

model TaskApplication {
  id        String   @id @default(uuid())
  taskId    String
  taskerId  String
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker User @relation(fields: [taskerId], references: [id], onDelete: Cascade)

  @@unique([taskId, taskerId])
  @@index([taskerId])
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  stripeAccountId  String?  @unique
  // Financial fields must be 12, 4 to support micro-cents and standard accounting precision
  balanceAvailable Float    @default(0.0)
  balanceEscrowed  Float    @default(0.0)
  currency         String   @default("USD")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions Transaction[]
}

model Transaction {
  id              String   @id @default(uuid())
  walletId        String
  taskId          String?
  escrowEntryId   String?
  amount          Float
  type            String
  status          String   @default("PENDING")
  // Required idempotency key to prevent double charging on webhook retries
  idempotencyKey  String?  @unique
  stripePaymentId String?  @unique
  metadata        String? // Unstructured log for raw stripe hooks
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  escrowEntry EscrowEntry? @relation(fields: [escrowEntryId], references: [id], onDelete: SetNull)

  // Critical indexes for wallet ledger derivation
  @@index([walletId, createdAt(sort: Desc)])
  @@index([walletId, status, type])
  @@index([taskId])
}

model EscrowEntry {
  id        String   @id @default(uuid())
  taskId    String   @unique
  amount    Float
  status    String   @default("LOCKED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task         Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  transactions Transaction[] // An escrow has multiple transactions (lock, release, refund, fee)

  @@index([status])
}

model PlatformRevenue {
  id            String   @id @default(uuid())
  taskId        String?  @unique
  transactionId String?  @unique
  amount        Float
  description   String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model Review {
  id         String   @id @default(uuid())
  taskId     String
  reviewerId String
  revieweeId String
  type       String
  rating     Int // 1-5 Scale, stored as SmallInt for perf
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer User @relation("GivenReviews", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee User @relation("ReceivedReviews", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([taskId, reviewerId, revieweeId])
  @@index([revieweeId, rating])
}

model UserMetrics {
  id                   String   @id @default(uuid())
  profileId            String   @unique
  tasksCompleted       Int      @default(0)
  tasksCancelled       Int      @default(0)
  totalEarned          Float    @default(0.0)
  totalSpent           Float    @default(0.0)
  avgRatingAsTasker    Float    @default(0.0)
  avgRatingAsRequester Float    @default(0.0)
  updatedAt            DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Notification {
  id              String   @id @default(uuid())
  userId          String
  type            String
  content         String
  relatedEntityId String? // IDs referencing tasks, disputes, messages
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model MessageThread {
  id          String   @id @default(uuid())
  taskId      String   @unique
  requesterId String
  taskerId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requester User @relation("RequesterThreads", fields: [requesterId], references: [id], onDelete: Restrict)
  tasker    User @relation("TaskerThreads", fields: [taskerId], references: [id], onDelete: Restrict)

  messages Message[]

  @@unique([requesterId, taskerId, taskId])
  @@index([requesterId])
  @@index([taskerId])
}

model Message {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  content   String
  type      String   @default("TEXT")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt(sort: Desc)])
}

model MediaAttachment {
  id         String   @id @default(uuid())
  taskId     String
  url        String
  fileType   String
  uploadedBy String
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Dispute {
  id         String   @id @default(uuid())
  taskId     String   @unique
  raisedById String
  reason     String
  status     String   @default("PENDING_REVIEW")
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  raisedBy User @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Restrict)

  @@index([status])
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  details    String? // Use JSON to capture structured exact before/after state
  createdAt  DateTime @default(now())

  admin User @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
}

model KYCVerification {
  id           String    @id @default(uuid())
  userId       String    @unique
  providerKey  String?   @unique // Connects external Persona/Jumio ref
  status       String    @default("UNVERIFIED")
  documentsUrl String?
  notes        String?
  submittedAt  DateTime?
  verifiedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Cancellation {
  id             String   @id @default(uuid())
  taskId         String
  userId         String
  reason         String
  penaltyApplied Boolean  @default(false)
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([userId])
}

model JobLock {
  id       String   @id
  lockedAt DateTime
}

model CooperativeFederation {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  state       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  societies         CooperativeSociety[]
  memberships       FederationMembership[]
  opportunities     InstitutionalOpportunity[]
  serviceCategories ServiceCategory[]
}

model CooperativeSociety {
  id           String   @id @default(uuid())
  federationId String
  name         String
  description  String?
  location     String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  federation               CooperativeFederation      @relation(fields: [federationId], references: [id], onDelete: Restrict)
  memberships              SocietyMembership[]
  InstitutionalOpportunity InstitutionalOpportunity[]

  @@index([federationId])
}

model FederationMembership {
  id           String   @id @default(uuid())
  userId       String
  federationId String
  role         String   @default("MEMBER")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  federation CooperativeFederation @relation(fields: [federationId], references: [id], onDelete: Cascade)

  @@unique([userId, federationId])
  @@index([userId])
  @@index([federationId])
}

model SocietyMembership {
  id        String   @id @default(uuid())
  userId    String
  societyId String
  role      String   @default("MEMBER")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  society CooperativeSociety @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([userId, societyId])
  @@index([userId])
  @@index([societyId])
}

model ServiceCategory {
  id           String   @id @default(uuid())
  federationId String
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  federation    CooperativeFederation      @relation(fields: [federationId], references: [id], onDelete: Cascade)
  services      Service[]
  opportunities InstitutionalOpportunity[]

  @@unique([federationId, name])
  @@index([federationId])
}

model Service {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String
  basePrice   Float
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tasks    Task[]
  skills   Skill[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Certification {
  id           String    @id @default(uuid())
  profileId    String
  skillId      String
  status       String    @default("PENDING")
  evidence     String?
  verifiedById String?
  verifiedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill      Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("VerifiedCertifications", fields: [verifiedById], references: [id])

  @@unique([profileId, skillId])
}

model WorkerWelfareProfile {
  id             String    @id @default(uuid())
  workerId       String    @unique
  isCovered      Boolean   @default(false)
  providerName   String?
  coverageType   String?
  premium        Float?
  coverageAmount Float?
  validUntil     DateTime?
  policyNumber   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  worker User @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model WelfareClaim {
  id                    String    @id @default(uuid())
  workerId              String
  title                 String
  description           String
  status                String    @default("PENDING")
  settlementAmount      Float?
  incidentDate          DateTime?
  supportingDocumentUrl String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  worker User @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model InstitutionalOpportunity {
  id          String    @id @default(uuid())
  title       String
  description String
  source      String?
  externalRef String?
  budget      Float?
  locationLat Float?
  locationLng Float?
  deadline    DateTime?
  status      String    @default("DRAFT")

  societyId    String?
  federationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society           CooperativeSociety?    @relation(fields: [societyId], references: [id])
  federation        CooperativeFederation? @relation(fields: [federationId], references: [id])
  ServiceCategory   ServiceCategory?       @relation(fields: [serviceCategoryId], references: [id])
  serviceCategoryId String?
}
